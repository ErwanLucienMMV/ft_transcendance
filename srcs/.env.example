APIPORT=3000

# Empty for same-origin Nginx; for a separate frontend use its exact origin(s), comma-separated.
CORS_ORIGINS=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=transcendence
DATABASE_USER=transcendence
DATABASE_PASSWORD=
POSTGRES_BACKUP_USER=MyNameIsBob
POSTGRES_BACKUP_PASSWORD=

APPPORT=8080
APPURL=https://localhost:${APPPORT}
HTTPPORT=80

# At least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Access token lifetime in seconds (default 3600).
JWT_EXPIRES_IN=3600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# forgemail (email verification). Leave SMTP_USER/SMTP_PASSWORD empty to only
# log emails. Gmail needs an app password, not the account password.
# OVH example: SMTP_HOST=smtp.mail.ovh.net, SMTP_PORT=465,
#              SMTP_USER=you@your-domain.tld, MAIL_FROM="ft_transcendence <you@your-domain.tld>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
