{
  "uid": "transcendence-matchmaking",
  "title": "Transcendence - Matchmaking",
  "description": "Retained matchmaking/game/puzzle database inventories, shared across replicas.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "matchmaking",
    "sprint4"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Shared database inventories",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Current WAITING players and distribution of waits for retained committed matches (two observations per match). Durations are seconds. These are gauge inventories, not process event counters: do not use rate(). Purging games removes match observations; puzzle attempt sessions can change solved state. max across replicas avoids counting the shared database twice. Bucket quantiles are estimates, and an empty distribution is undefined. No data is unknown; inspect scrape health."
      }
    },
    {
      "id": 2,
      "title": "Waiting players",
      "type": "timeseries",
      "description": "Instantaneous shared PostgreSQL inventory; max across application replicas. No rate or sum across replicas.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(matchmaking_queue_size{job=\"nestjs\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Waiting players"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "Retained matched players",
      "type": "timeseries",
      "description": "Instantaneous shared PostgreSQL inventory; max across application replicas. No rate or sum across replicas.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(matchmaking_wait_seconds_count{job=\"nestjs\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Retained matched players"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "Median retained wait",
      "type": "timeseries",
      "description": "Instantaneous shared PostgreSQL inventory; max across application replicas. No rate or sum across replicas.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, max by (le) (matchmaking_wait_seconds_bucket{job=\"nestjs\"}))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "Median retained wait"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
